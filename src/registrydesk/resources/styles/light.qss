QWidget {
    background-color: #f5f5f5;
    color: #202124;
}
QLineEdit, QListWidget, QTableView, QComboBox {
    background-color: #ffffff;
    color: #202124;
    border: 1px solid #c8c8c8;
}
QPushButton {
    background-color: #ffffff;
    color: #202124;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: #eeeeee;
}
QPushButton:disabled {
    color: #8a8a8a;
}
QHeaderView::section {
    background-color: #e9e9e9;
    color: #202124;
    border: 1px solid #c8c8c8;
}
